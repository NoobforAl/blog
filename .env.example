# Copy to .env and adjust. The Makefile loads this file automatically.

# Base URL of the deployed site. Baked into the generated sitemap.xml,
# robots.txt, and feed.xml at build time (build.rs).
SITE_URL=http://localhost:3000

# Docker image name and tag used by `make docker-build`.
# TAG defaults to the latest git tag without the leading "v" (or "latest").
IMAGE=blog
#TAG=0.1.0

# Origins allowed to make cross-origin requests, read by docker-compose.yml
# (maps to SERVER_CORS_ALLOW_ORIGINS in the container). Comma-separated list,
# or "*" to allow any origin. Used when serving on multiple domains.
#CORS_ORIGINS=https://example.com,https://www.example.com
