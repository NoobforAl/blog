# Copy to .env and adjust. The Makefile loads this file automatically.

# Base URL of the deployed site. Baked into the generated sitemap.xml,
# robots.txt, and feed.xml at build time (build.rs).
SITE_URL=http://localhost:3000

# Docker image name and tag used by `make image`.
# TAG defaults to the latest git tag without the leading "v" (or "latest").
IMAGE=blog
#TAG=0.1.0
